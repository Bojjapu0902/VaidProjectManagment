# Points the app at a backend. Defaults to the local Server (http://localhost:5000/api/v1)
# when unset. Set this to the deployed API's URL for a production build, and make sure
# that origin is added to CLIENT_ORIGIN in the backend's env — otherwise CORS rejects it.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# "true" short-circuits every service call with local mock data instead of hitting the
# API at all (see src/services/mockAdapter.js). Leave unset/"false" to use the real backend.
VITE_USE_MOCKS=false
