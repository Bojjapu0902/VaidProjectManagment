PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vaid_project_management
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# JWT — separate secrets for access vs. refresh tokens (rotate independently)
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Back-compat fallback if the split secrets above aren't set (dev only):
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (optional in dev — if unset, emails are logged instead of sent)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=no-reply@archpro.com
